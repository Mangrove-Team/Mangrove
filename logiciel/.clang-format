# Mangrove Project - C++ formatting (Qt-like style)
---
Language: Cpp
BasedOnStyle: WebKit
Standard: c++20
ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never

AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: All
AlwaysBreakTemplateDeclarations: Yes
BreakBeforeBinaryOperators: All
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterClass: false
  AfterStruct: false
  AfterEnum: false
  AfterNamespace: false
  AfterControlStatement: Never
  BeforeElse: false
  SplitEmptyFunction: false
BreakConstructorInitializers: BeforeColon
CompactNamespaces: false
Cpp11BracedListStyle: true
SpaceBeforeCpp11BracedList: false
FixNamespaceComments: true
IndentCaseLabels: false
InsertNewlineAtEOF: true
NamespaceIndentation: None
PointerAlignment: Right
ReferenceAlignment: Right
SpaceAfterTemplateKeyword: false

IncludeBlocks: Preserve
SortIncludes: CaseSensitive

# Qt macros that behave like access specifiers or statements
StatementMacros: [Q_OBJECT, Q_GADGET, QML_ELEMENT, QML_SINGLETON, Q_DECLARE_TR_FUNCTIONS]
WhitespaceSensitiveMacros: [QML_UNCREATABLE]
