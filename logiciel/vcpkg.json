{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "mangrove",
  "version-string": "0.1.0",
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "network",
        "thread",
        "concurrent",
        "freetype",
        "harfbuzz",
        "png",
        "jpeg",
        "pcre2",
        "doubleconversion",
        "opengl",
        { "name": "fontconfig", "platform": "linux" },
        { "name": "egl", "platform": "linux" },
        { "name": "xcb", "platform": "linux" },
        { "name": "xcb-xlib", "platform": "linux" },
        { "name": "xrender", "platform": "linux" },
        { "name": "windeployqt", "platform": "windows" }
      ]
    },
    "qtdeclarative",
    "qtsvg",
    {
      "name": "qttools",
      "default-features": false,
      "features": ["linguist"]
    }
  ]
}
