# clangd (IDE analysis only, does not affect the build).
CompileFlags:
  # Uses build/compile_commands.json, generated by CMake.
  CompilationDatabase: build
  # Added by Qt's CMake targets when Qt is built with GCC. GCC-only flag that
  # clang does not know: it would raise "Unknown argument" on every file.
  Remove: [-mno-direct-extern-access]
